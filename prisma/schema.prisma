generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// PHASE 0: Multi-Tenant Foundation
// ------------------------------------------------------------------
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  blueprints  Blueprint[]
  leads       Lead[]
  auditLogs   AuditLog[]
  tags        Tag[]
  accounts    Account[]
  products    Product[]
  tasks       Task[]
  deals       Deal[]
  profiles    Profile[]
  workflowRules WorkflowRule[]
  invitations Invitation[]
  clientScripts ClientScript[]
  walletTransactions WalletTransaction[]
  campaigns   Campaign[]
  chatMessages ChatMessage[]

  walletBalance Float @default(0)

  // Meta WhatsApp API Credentials
  whatsappAccessToken   String?
  whatsappPhoneNumberId String?
  whatsappWabaId        String?
}

// ------------------------------------------------------------------
// PHASE 0.5: RBAC (Role-Based Access Control)
// ------------------------------------------------------------------
model Profile {
  id             String @id @default(uuid())
  organizationId String
  name           String // e.g. "Admin", "Sales Rep"

  // High-Level Toggles
  canAccessSettings Boolean @default(false)
  canManageUsers    Boolean @default(false)
  canExportData     Boolean @default(false)

  // Module Level Permissions
  permissions Json // e.g. { "Lead": { read: true, create: true, update: true, delete: false } }

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  invitations  Invitation[]
}

model User {
  id             String   @id // AWS Cognito User ID
  email          String   @unique
  organizationId String
  profileId      String?
  isActive       Boolean  @default(true) // For revoking access
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  profile      Profile?     @relation(fields: [profileId], references: [id])
}

model Invitation {
  id             String   @id @default(uuid())
  email          String
  token          String   @unique
  organizationId String
  profileId      String // The RBAC role they will get
  status         String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  profile      Profile      @relation(fields: [profileId], references: [id])

  @@unique([email, organizationId])
}

// ------------------------------------------------------------------
// PHASE 1: The Blueprint Contract (Config)
// ------------------------------------------------------------------
model Blueprint {
  id             String @id @default(uuid())
  organizationId String
  moduleType     String // e.g., "Lead", "Deal", "Ticket"
  version        Int    @default(1)
  name           String @default("Default Pipeline")

  stages      Stage[]
  transitions Transition[]
  fields      Field[]
  leads       Lead[]
  accounts    Account[]
  products    Product[]
  tasks       Task[]
  deals       Deal[]

  layoutConfig Json? // Array of { id: string, name: string, columns: 1|2|3, order: number }

  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduleType, version])
}

model Stage {
  id             String   @id @default(uuid())
  blueprintId    String
  name           String // e.g., "New", "Contacted"
  orderIndex     Int
  requiredFields String[] // Array of field names required to enter this stage
  color          String?

  blueprint Blueprint @relation(fields: [blueprintId], references: [id])
  leads     Lead[]
  accounts  Account[]
  products  Product[]
  tasks     Task[]
  deals     Deal[]

  outgoingTransitions Transition[] @relation("FromStages")
  incomingTransitions Transition[] @relation("ToStage")
}

model Field {
  id          String   @id @default(uuid())
  blueprintId String
  name        String // JSON key, e.g., "industry"
  label       String // Display name, e.g., "Industry"
  type        String // "text", "number", "select", "currency", "lookup"
  options     String[] // Dropdown options
  isRequired  Boolean  @default(false)
  orderIndex  Int

  // Lookup specific fields
  targetModule       String?
  targetDisplayField String?
  isMultiSelect      Boolean @default(false)
  isBiDirectional    Boolean @default(false)
  relatedListLabel   String?
  isPublic           Boolean @default(true)
  filters            Json?
  mappings           Json?
  subformFields      Json?

  // Layout Builder & Section Support
  sectionName        String  @default("General Information")
  sectionOrder       Int     @default(0)
  isSystemField      Boolean @default(false)
  isHidden           Boolean @default(false)

  blueprint Blueprint @relation(fields: [blueprintId], references: [id])
}

model Transition {
  id              String    @id @default(uuid())
  blueprintId     String
  name            String // e.g., "Qualify Lead" or "Move to Trash"
  fromStages      Stage[]   @relation("FromStages")
  toStageId       String
  requiredFields  String[] // Fields required to execute this transition
  necessaryFields String[] // High-friction security checkpoint fields
  visibleFields   String[] //  Fields shown on transition, but not mandatory
  blueprint       Blueprint @relation(fields: [blueprintId], references: [id])
  toStage         Stage     @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  isGlobal        Boolean   @default(false)

  // Advanced Workflow Controls
  executionCriteria Json? // { type: 'all' | 'matching', conditions: [] }
  customMessage     String?
  checklists        String[]
  afterActions      Json? // { emails: [], webhooks: [], etc. }
}

// ------------------------------------------------------------------
// PHASE 2: The Data & Audit Layer
// ------------------------------------------------------------------
model Lead {
  id             String @id @default(uuid())
  organizationId String
  blueprintId    String
  stageId        String // Dropdown (New / Contacted / Qualified / Close Won / Close Lost / Junk)

  // 1. Identification
  fullName      String? // (Mandatory UI par hoga, abhi DB me optional rakh rahe hain migration tak)
  firstName     String? // (Old: Delete later)
  lastName      String? // (Old: Delete later)
  companyName   String?
  
  // Address Block
  street        String?
  city          String?
  state         String?
  country       String?
  zipCode       String?

  // 2. Contact
  email          String?
  phone          String?
  alternatePhone String?

  // 3. Classification & Sales Process
  owner            String? // (Login User Default)
  leadSource       String? // (Website / Referral / Campaign / Cold Call / Event / Other)
  priority         String? // (Low / Medium / High)
  nextFollowUpDate DateTime?
  notes            String? @db.Text // Long Text ke liye @db.Text lagana better hai

  // 4. System Fields (Preview Screen Only)
  createdAt        DateTime @default(now()) // (Created Date)
  updatedAt        DateTime @updatedAt      // (Last Modified Date auto updates)
  lastActivityDate DateTime? // (Update on calls/emails/notes)
  lastModifiedById String?   // (User ID jisne last modify kiya)

  // Dynamic payload for Custom Fields
  customData Json  @default("{}")
  tags       Tag[]

  organization Organization @relation(fields: [organizationId], references: [id])
  blueprint    Blueprint    @relation(fields: [blueprintId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])
  auditLogs    AuditLog[]
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  leadId         String
  actionType     String // e.g., "LeadCreated", "StageMoved", "FieldUpdated"
  details        Json // e.g., { fromStage: "New", toStage: "Contacted" }
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  moduleType     String   @default("Lead")
  name           String
  color          String   @default("#ef4444")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  leads        Lead[]
  deals        Deal[]
}

model Account {
  id             String @id @default(uuid())
  organizationId String
  blueprintId    String
  stageId        String

  // ---------------- IDENTIFICATION ----------------
  accountName   String
  industry      String?
  website       String?

  // ---------------- CONTACT ----------------
  email           String?
  primaryContact  String?
  billingAddress  String?
  shippingAddress String?
  contactPerson   String? 

  // ---------------- BUSINESS DETAILS ----------------
  teamSize      Int?
  annualRevenue Float?
  taxId         String?
  paymentTerms  String?

  // ---------------- RELATIONSHIP & OWNERSHIP ----------------
  status        String   @default("Active")
  owner         String?
  parentAccount String?
  relatedDeals  String?
  relatedLeads  String?

  // ---------------- SYSTEM FIELDS ----------------
  lastActivityDate DateTime?
  lastModifiedById String?

  // Dynamic payload for custom fields
  customData Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  blueprint    Blueprint    @relation(fields: [blueprintId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])
}


model Product {
  id             String @id @default(uuid())
  organizationId String
  blueprintId    String
  stageId        String

  // Default/Standard Fields
  name             String
  sku              String?   // SKU ko optional kar diya gaya hai
  
  // --- NAYE FIELDS YAHAN SE ADD KIYE HAIN ---
  category         String?
  description      String?
  status           String    @default("Active")
  unitPrice        Float?
  costPrice        Float?
  totalRevenue     Float?
  images           Json?     // S3 links ki array save karne ke liye
  // ------------------------------------------

  // Dynamic payload for custom fields
  customData Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastActivityDate DateTime?
  lastModifiedById String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  blueprint    Blueprint    @relation(fields: [blueprintId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])

  // Isse DB level par assure hoga ki ek company me do products ka same SKU nahi ho sakta
  @@unique([organizationId, sku])
}

model Task {
  id             String @id @default(uuid())
  organizationId String
  blueprintId    String
  stageId        String

  // Default/Standard Fields
  taskName         String
  startDateTime    DateTime?
  dueDateTime      DateTime?
  endDateTime      DateTime?
  repeat           String?
  alert            String?
  notes            String?
  owner            String?
  
  // --- NAYE FIELDS YAHAN SE ADD KIYE HAIN ---
  priority         String?
  taskType         String?
  assignedBy       String?
  relatedModule    String?
  relatedRecordId  String?
  taskAutomation   String?
  completionSource String?
  lastActivityDate DateTime?
  lastModifiedById String?
  // ------------------------------------------

  // Dynamic payload for custom fields
  customData Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  blueprint    Blueprint    @relation(fields: [blueprintId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])
}


model Deal {
  id             String @id @default(uuid())
  organizationId String
  blueprintId    String
  stageId        String

  // 1. Identification
  dealName          String?
  companyName       String?
  address           String?
  convertedFromLead String?

  // 2. Contact
  email             String?
  primaryContact    String?
  alternatePhone    String?

  // 3. Financials
  dealValue         Float?      
  probability       Float?      
  weightedValue     Float?      
  expectedCloseDate DateTime?   
  actualCloseDate   DateTime?   

  // 4. Sales Process
  owner             String?
  dealSource        String?
  priority          String?
  nextStep          String?
  nextFollowUpDate  DateTime?   
  lossReason        String?
  products          Json?
  notes             String?

  // 5. System Fields
  lastActivityDate  DateTime?
  lastModifiedById  String?     

  // Dynamic payload
  customData Json  @default("{}")
  tags       Tag[]

  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt      

  organization Organization @relation(fields: [organizationId], references: [id])
  blueprint    Blueprint    @relation(fields: [blueprintId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])
}


model WorkflowRule {
  id             String   @id @default(uuid())
  organizationId String
  moduleType     String
  name           String
  recordEvent    String
  triggerCategory String
  triggerEvent    String
  targetFields    String[]
  code            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ClientScript {
  id            String   @id @default(uuid())
  organizationId String
  name          String
  moduleType    String   // e.g., "Lead", "Deal", "Product"
  triggerEvent  String   // "onLoad", "onChange", "onSave"
  targetField   String?  // Only populated if triggerEvent is "onChange"
  code          String   // The JavaScript code
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum TransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id             String          @id @default(uuid())
  organizationId String
  amount         Float
  type           TransactionType
  description    String
  referenceId    String?
  createdAt      DateTime        @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ------------------------------------------------------------------
// PHASE 2.2b: SQS Bulk Campaign Engine
// ------------------------------------------------------------------
model Campaign {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("DRAFT") // DRAFT, PROCESSING, COMPLETED
  estimatedCost  Float    @default(0)
  totalLeads     Int      @default(0)
  successCount   Int      @default(0)
  failedCount    Int      @default(0)
  templateBody   String
  targetStageId  String?  // If they targeted a specific stage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ChatMessage {
  id             String   @id @default(uuid())
  organizationId String
  direction      String   // OUTBOUND or INBOUND
  toPhone        String
  fromPhone      String?
  body           String
  status         String   // SENT, DELIVERED, READ, FAILED
  cost           Float    @default(0)
  campaignId     String?  // Null if it was a 1-on-1 manual message
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}
