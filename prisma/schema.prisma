generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String              @id @default(uuid())
  name                  String
  createdAt             DateTime            @default(now())
  walletBalance         Float               @default(0)
  whatsappAccessToken   String?
  whatsappPhoneNumberId String?
  whatsappWabaId        String?
  industry              String?
  logoUrl               String?
  teamSize              String?
  accounts              Account[]
  auditLogs             AuditLog[]
  blueprints            Blueprint[]
  campaigns             Campaign[]
  chatMessages          ChatMessage[]
  clientScripts         ClientScript[]
  deals                 Deal[]
  invitations           Invitation[]
  leads                 Lead[]
  products              Product[]
  profiles              Profile[]
  tags                  Tag[]
  tasks                 Task[]
  users                 User[]
  walletTransactions    WalletTransaction[]
  workflowRules         WorkflowRule[]
}

model Profile {
  id                  String       @id @default(uuid())
  organizationId      String
  name                String
  canAccessSettings   Boolean      @default(false)
  canManageUsers      Boolean      @default(false)
  canExportData       Boolean      @default(false)
  permissions         Json
  avatarUrl           String?
  nickname            String?
  onboardingCompleted Boolean      @default(false)
  role                String?
  invitations         Invitation[]
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users               User[]
}

model User {
  id             String       @id
  email          String       @unique
  organizationId String
  createdAt      DateTime     @default(now())
  profileId      String?
  isActive       Boolean      @default(true)
  reportsToId    String?      // Manager Hierarchy
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reportsTo      User?        @relation("ManagerHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates   User[]       @relation("ManagerHierarchy")
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  token          String       @unique
  organizationId String
  profileId      String
  status         String       @default("PENDING")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
}

model Blueprint {
  id             String       @id @default(uuid())
  organizationId String
  moduleType     String
  version        Int          @default(1)
  name           String       @default("Default Pipeline")
  layoutConfig   Json?
  isActive       Boolean      @default(true)
  updatedAt      DateTime     @default(now()) @updatedAt
  entryCriteria  Json?
  executionOrder Int          @default(0)
  targetField    String       @default("")
  accounts       Account[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  fields         Field[]
  leads          Lead[]
  products       Product[]
  stages         Stage[]
  tasks          Task[]
  transitions    Transition[]
}

model Stage {
  id                  String       @id @default(uuid())
  blueprintId         String
  name                String
  orderIndex          Int
  requiredFields      String[]
  color               String?
  isSystem            Boolean      @default(false)
  accounts            Account[]
  deals               Deal[]
  leads               Lead[]
  products            Product[]
  blueprint           Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  tasks               Task[]
  incomingTransitions Transition[] @relation("ToStage")
  outgoingTransitions Transition[] @relation("FromStages")
}

model Field {
  id                 String    @id @default(uuid())
  blueprintId        String
  name               String
  label              String
  type               String
  options            String[]
  isRequired         Boolean   @default(false)
  orderIndex         Int
  isBiDirectional    Boolean   @default(false)
  isMultiSelect      Boolean   @default(false)
  targetModule       String?
  mappings           Json?
  targetDisplayField String?
  filters            Json?
  isPublic           Boolean   @default(true)
  relatedListLabel   String?
  subformFields      Json?
  isHidden           Boolean   @default(false)
  isSystemField      Boolean   @default(false)
  sectionName        String    @default("General Information")
  sectionOrder       Int       @default(0)
  blueprint          Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
}

model Transition {
  id                String    @id @default(uuid())
  blueprintId       String
  name              String
  toStageId         String
  requiredFields    String[]
  necessaryFields   String[]
  isGlobal          Boolean   @default(false)
  afterActions      Json?
  checklists        String[]
  customMessage     String?
  executionCriteria Json?
  visibleFields     String[]
  blueprint         Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  toStage           Stage     @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  fromStages        Stage[]   @relation("FromStages")
}

model Lead {
  id               String       @id @default(uuid())
  organizationId   String
  blueprintId      String
  stageId          String
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  owner            String?
  customData       Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  alternatePhone   String?
  city             String?
  companyName      String?
  country          String?
  fullName         String?
  lastActivityDate DateTime?
  lastModifiedById String?
  leadSource       String?
  nextFollowUpDate DateTime?
  notes            String?
  priority         String?
  state            String?
  street           String?
  zipCode          String?
  auditLogs        AuditLog[]
  blueprint        Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage            Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tags             Tag[]        @relation("LeadToTag")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  actionType     String
  details        Json
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Tag {
  id             String       @id @default(uuid())
  organizationId String
  moduleType     String       @default("Lead")
  name           String
  color          String       @default("#ef4444")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]       @relation("DealToTag")
  leads          Lead[]       @relation("LeadToTag")
}

model Account {
  id               String       @id @default(uuid())
  organizationId   String
  blueprintId      String
  stageId          String
  email            String?
  website          String?
  contactPerson    String?
  customData       Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  accountName      String
  annualRevenue    Float?
  billingAddress   String?
  industry         String?
  lastActivityDate DateTime?
  lastModifiedById String?
  owner            String?
  parentAccount    String?
  paymentTerms     String?
  primaryContact   String?
  relatedDeals     String?
  relatedLeads     String?
  shippingAddress  String?
  status           String       @default("Active")
  taxId            String?
  teamSize         Int?
  blueprint        Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage            Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Product {
  id               String       @id @default(uuid())
  organizationId   String
  blueprintId      String
  stageId          String
  name             String
  sku              String?
  customData       Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  category         String?
  costPrice        Float?
  description      String?
  images           Json?
  lastActivityDate DateTime?
  lastModifiedById String?
  status           String       @default("Active")
  totalRevenue     Float?
  unitPrice        Float?
  blueprint        Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage            Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
}

model Task {
  id               String       @id @default(uuid())
  organizationId   String
  blueprintId      String
  stageId          String
  taskName         String
  startDateTime    DateTime?
  dueDateTime      DateTime?
  endDateTime      DateTime?
  repeat           String?
  alert            String?
  notes            String?
  customData       Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  owner            String?
  assignedBy       String?
  completionSource String?
  lastActivityDate DateTime?
  lastModifiedById String?
  priority         String?
  relatedModule    String?
  relatedRecordId  String?
  taskAutomation   String?
  taskType         String?
  blueprint        Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage            Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Deal {
  id                String       @id @default(uuid())
  organizationId    String
  blueprintId       String
  stageId           String
  email             String?
  owner             String?
  customData        Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  actualCloseDate   DateTime?
  address           String?
  alternatePhone    String?
  companyName       String?
  convertedFromLead String?
  dealName          String?
  dealSource        String?
  dealValue         Float?
  expectedCloseDate DateTime?
  lastActivityDate  DateTime?
  lossReason        String?
  nextFollowUpDate  DateTime?
  nextStep          String?
  notes             String?
  primaryContact    String?
  priority          String?
  probability       Float?
  products          Json?
  weightedValue     Float?
  lastModifiedById  String?
  blueprint         Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage             Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tags              Tag[]        @relation("DealToTag")
}

model WorkflowRule {
  id              String       @id @default(uuid())
  organizationId  String
  moduleType      String
  name            String
  recordEvent     String
  triggerCategory String
  triggerEvent    String
  targetFields    String[]
  code            String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ClientScript {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  moduleType     String
  triggerEvent   String
  targetField    String?
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id             String          @id @default(uuid())
  organizationId String
  amount         Float
  type           TransactionType
  description    String
  referenceId    String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  status         String       @default("DRAFT")
  estimatedCost  Float        @default(0)
  totalLeads     Int          @default(0)
  successCount   Int          @default(0)
  failedCount    Int          @default(0)
  templateBody   String
  targetStageId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id             String       @id @default(uuid())
  organizationId String
  direction      String
  toPhone        String
  fromPhone      String?
  body           String
  status         String
  cost           Float        @default(0)
  campaignId     String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  CREDIT
  DEBIT
}
